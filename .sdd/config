[sdd]
	profile = lite
	mode = solo
	base = main
	forge = github
[check]
	run = shellcheck -s sh -S warning .sdd/bin/sdd .sdd/core/lib/common.sh .sdd/core/cmd/*.sh .sdd/core/agents/*.sh .sdd/core/forges/*.sh tests/*.sh tests/constitution/*.sh
	run = sh tests/run.sh /bin/sh dash
	# Item 38: sdd's own gate (shellcheck, then 35 test files under two shells, ~450 CPU-s,
	# mostly process starts) takes 105-145 s on the 12-CPU dev Mac while other sessions load it.
	# The 60 s goal was not reached without dropping tests; see item 38's Built.
	budget = 150
