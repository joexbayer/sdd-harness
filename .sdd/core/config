# Defaults. Override in .sdd/config (project) or ~/.config/sdd/config (you);
# lookup order is project, user, then this file. Read with `git config -f`.

[sdd]
	profile = lite
	mode = solo
	base = main
	branch = {type}/{id}-{slug}
	gates = planned analyzed approved tasks check built verified reviewed depends

# Gate levels per profile: off, warn or block.
#   planned    every required plan section (above "## Built") has content
#   analyzed   at approve: `sdd analyze` finds no problem in the plan (an FR no task names, an
#              FR with no example, an open question, an ID written twice, an unreadable task)
#   approved   the human approved the plan, it has not changed since, and no code was
#              committed before the approval
#   check      the configured checks pass for exactly the code being shipped
#   built      "## Built" (what was built, how it was verified) is written
#   verified   "## Built" has a "Verified by:" line other than "none": someone other than the
#              builder (the verifier role) proved the requirements by running them
#   reviewed   the code is what the human last saw in `sdd review` in this clone (a rebase that
#              keeps the change keeps it reviewed; an item that changes no code needs none)
#   tasks      the plan has tasks and every one is ticked (off for fix, refactor and amendment);
#              a ticked task needs a commit naming it in every profile, whatever this level
#   depends    every item and roadmap entry in the item's `depends:` has shipped (an item ID like
#              31, or an entry like R-30.1: the item opened from it); planning and building go on
#   finish     agent stop hook: no stopping with unplanned, unapproved, unverified or
#              unwritten-up code changes (blocks once, then lets it stop with a warning)
[profile "lite"]
	planned = warn
	analyzed = warn
	approved = block
	check = block
	built = warn
	tasks = warn
	verified = off
	reviewed = warn
	depends = warn
	finish = block
[profile "standard"]
	planned = block
	analyzed = block
	approved = block
	check = block
	built = block
	tasks = block
	verified = warn
	reviewed = warn
	depends = block
	finish = block
[profile "strict"]
	planned = block
	analyzed = block
	approved = block
	check = block
	built = block
	tasks = block
	verified = block
	reviewed = block
	depends = block
	finish = block

# A type exists when templates/<type>.md exists. Settings here are optional:
#   gates      which gates apply (default: sdd.gates)
#   <gate>     a level that beats the profile's
#   branch     branch name template (last part must be {id}-{slug})
#   lands      "item" = only the archived item reaches the base branch, never the code
[type "hotfix"]
	gates = planned check built
	planned = warn
[type "chore"]
	gates = planned check built depends
[type "amendment"]
	# Changes the constitution: every gate blocks, in every profile.
	planned = block
	analyzed = block
	approved = block
	check = block
	built = block
	verified = block
	reviewed = block
	tasks = off
[type "fix"]
	tasks = off
[type "refactor"]
	tasks = off
[type "spike"]
	gates = planned approved built depends
	lands = item
[type "roadmap"]
	# A system as items in order (R-<id>.<n> entries); like a spike, only the item lands.
	gates = planned analyzed approved built
	lands = item

# Output that means a whole check run proved nothing (extended regex, case-insensitive).
# Only summary lines: per-package lines like cargo's doc-tests "running 0 tests" or go's
# "[no tests to run]" also appear in healthy runs.
[check]
	no-tests = collected 0 items
	no-tests = Ran 0 tests
	no-tests = (^|[^0-9])0 examples
	no-tests = (^|[^0-9])0 passing
	no-tests = No tests found
	no-tests = Tests:[[:space:]]+0 total

# The constitution (specs/constitution.md) is capped, because budgets are lint errors.
[constitution]
	max-articles = 30
# Files whose diffs the human reads in full in `review`: dependencies, CI and agent config change
# what runs, with what, and who decides (shell patterns, * matches /). Lines in .sdd/config add
# to these; the tool's own folder always counts.
[review]
	sensitive = *package-lock.json
	sensitive = *yarn.lock
	sensitive = *pnpm-lock.yaml
	sensitive = *Gemfile.lock
	sensitive = *poetry.lock
	sensitive = *uv.lock
	sensitive = *Cargo.lock
	sensitive = *go.sum
	sensitive = *package.json
	sensitive = *Gemfile
	sensitive = *pyproject.toml
	sensitive = *requirements*.txt
	sensitive = *Cargo.toml
	sensitive = *go.mod
	sensitive = .github/*
	sensitive = .gitlab-ci.yml
	sensitive = AGENTS.md
	sensitive = CLAUDE.md
	sensitive = .claude/*
	sensitive = .mcp.json
	sensitive = .codex/*
	sensitive = .cursor/*
# Building: `sdd task next` gives the builder the first open task, joined by the open
# `size: S` tasks right after it (while it is S too), up to this many; M and L tasks run alone.
# A task with `expect: fail` ends its batch.
[build]
	batch = 3
# Usage tracking: one line per role run (sdd run, role subagents) in .git/sdd/runs.tsv, read by
# `sdd usage`. Off unless someone asks for it, here or in their own ~/.config/sdd/config.
[usage]
	track = false
